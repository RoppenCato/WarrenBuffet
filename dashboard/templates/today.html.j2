{% extends "base.html.j2" %}
{% block title %}Today{% endblock %}
{% block content %}
  <p class="sub">Suggestions from the scan at {{ scan_time }}, {{ age }} ago{% if stale %} — <strong>rescan before acting</strong>{% endif %}.
    Each line says why. You make every click; nothing here acts for you. Beta data, thresholds untuned.</p>

  <section class="tiles">
    {% for t in tiles %}
    <div class="tile"><div class="label">{{ t.label }}</div><div class="value">{{ t.value }}</div><p class="note">{{ t.note }}</p></div>
    {% endfor %}
  </section>

  <section class="card">
    <h2>News</h2>
    {% if news.waiting %}
    <p class="why">{{ news.waiting | length }} flagged {{ "story is" if news.waiting | length == 1 else "stories are" }} waiting for a review.
      Paste this into Claude Code and it reads them, records what matters and updates the calendar:</p>
    <p class="prompt"><code>{{ news.prompt }}</code><button type="button" data-copy="{{ news.prompt }}">Copy</button></p>
    <ul class="news">
      {% for s in news.waiting %}<li><a href="{{ s.link }}">{{ s.title }}</a><div class="meta">{{ s.date }} · flagged for {{ s.why }}</div></li>{% endfor %}
    </ul>
    {% elif news.stored %}
    <p class="why">No flagged stories are waiting for a review.</p>
    {% else %}
    <p class="why">No news pulled yet. Use Refresh, or run <code>python -m pipeline.news pull</code>.</p>
    {% endif %}
    {% if news.reviewed %}
    <h3 style="font-size:15px;margin:14px 0 0">Reviewed, last 14 days</h3>
    <ul class="news">
      {% for r in news.reviewed %}<li><span class="act{% if r.verdict != "relevant" %} quiet{% endif %}">{{ r.verdict | capitalize }}</span>
        <a href="{{ r.link }}">{{ r.title }}</a>
        <div class="meta">{{ r.date }}{% if r.action %} · {{ r.action }}{% endif %}</div>
        <div>{{ r.effect }}</div></li>{% endfor %}
    </ul>
    {% endif %}
    {% if news.weak %}
    <details><summary>{{ news.weak | length }} weaker matches, not queued for review</summary><ul class="news">
      {% for s in news.weak %}<li><a href="{{ s.link }}">{{ s.title }}</a><div class="meta">{{ s.date }} · {{ s.why }}</div></li>{% endfor %}
    </ul></details>
    {% endif %}
    <p class="note">Headlines: <a href="{{ news.attribution.url }}">{{ news.attribution.text }}</a>. The "effect" lines are our own reading, not Wowhead's.</p>
  </section>

  <section class="card">
    <h2>Sell</h2>
    {% if not has_inventory %}
    <p class="why">No inventory snapshot yet. It needs addon v0.4: log in, open the bank once, then <code>/reload</code>.</p>
    {% elif not sells %}
    <p class="why">Nothing sellable in your bags or bank ({{ inv_time }}).</p>
    {% else %}
    <p class="why">What you hold in bags and bank ({{ inv_time }}), against the cheapest listing now.</p>
    <div class="scroll"><table>
      <tr><th>Do</th><th>Item</th><th class="num">Units</th><th class="num">List at</th><th class="num">You get</th><th>Why</th></tr>
      {% for r in sells %}<tr><td><span class="act{% if r.quiet %} quiet{% endif %}">{{ r.label }}</span></td><td>{{ r.name }}</td>
        <td class="num">{{ "{:,}".format(r.units) }}</td><td class="num">{{ r.price }}</td><td class="num">{{ r.net }}</td>
        <td class="reason">{{ r.why }}</td></tr>{% endfor %}
    </table></div>
    <p class="note">"You get" is after a 5 % AH cut and a 1s deposit. 7-day medians and sold-per-day: <a href="{{ attribution.url }}">{{ attribution.text }}</a>.</p>
    {% endif %}
    {% if inv_err %}<p class="note">Inventory snapshot error: {{ inv_err }}</p>{% endif %}
  </section>

  <section class="card">
    <h2>Your auctions</h2>
    {% if not has_auctions %}
    <p class="why">No snapshot of your auctions yet. Open the AH once with addon v0.4, then <code>/reload</code>.</p>
    {% elif not reposts %}
    <p class="why">No active auctions ({{ auctions_time }}).</p>
    {% else %}
    <p class="why">Your active auctions ({{ auctions_time }}) against the cheapest listing in the scan.</p>
    <div class="scroll"><table>
      <tr><th>Do</th><th>Item</th><th class="num">Units</th><th class="num">Your price</th><th class="num">Cheapest now</th><th class="num">Time left</th><th>Why</th></tr>
      {% for r in reposts %}<tr><td><span class="act{% if r.quiet %} quiet{% endif %}">{{ r.label }}</span></td><td>{{ r.name }}</td>
        <td class="num">{{ "{:,}".format(r.units) }}</td><td class="num">{{ r.price }}</td><td class="num">{{ r.cheapest }}</td>
        <td class="num">{{ r.left }}</td><td class="reason">{{ r.why }}</td></tr>{% endfor %}
    </table></div>
    {% endif %}
  </section>

  <section class="card">
    <h2>Buy</h2>
    <p class="why">Lots priced well under their normal level in items that sell fast, to relist. You have {{ balance }}.</p>
    {% if buys %}
    <div class="scroll"><table>
      <tr><th>Do</th><th>Item</th><th class="num">Up to</th><th class="num">At or under</th><th class="num">Relist at</th><th class="num">Cost</th><th class="num">Est. profit</th><th>Why</th></tr>
      {% for r in buys %}<tr><td><span class="act{% if r.quiet %} quiet{% endif %}">{{ r.label }}</span></td><td>{{ r.name }}</td>
        <td class="num">{{ "{:,}".format(r.units) }}</td><td class="num">{{ r.max_price }}</td><td class="num">{{ r.resale }}</td>
        <td class="num">{{ r.cost }}</td><td class="num">{{ r.profit }}</td><td class="reason">{{ r.why }}</td></tr>{% endfor %}
    </table></div>
    <p class="note">Profit is after a 5 % AH cut and a 1s deposit. A lot can be gone minutes after the scan. 7-day medians and sold-per-day: <a href="{{ attribution.url }}">{{ attribution.text }}</a>.</p>
    {% else %}
    <p class="note">Nothing passes the rules in this scan.</p>
    {% endif %}
  </section>

  <section class="card">
    <h2>Calendar</h2>
    {% if phase %}
    <p class="why"><strong>{{ phase.label }}:</strong> {{ phase.focus }}</p>
    {% else %}
    <p class="why">No phase is active yet. The phase advice from the playbook starts at launch.</p>
    {% endif %}
    <div class="scroll"><table>
      <tr><th class="num">In</th><th>Date</th><th>Event</th><th>Note</th></tr>
      {% for e in upcoming %}<tr><td class="num">{{ e.days }} days</td><td>{{ e.date }}</td><td>{{ e.label }}</td><td class="reason">{{ e.note }}</td></tr>{% endfor %}
    </table></div>
  </section>
{% endblock %}
