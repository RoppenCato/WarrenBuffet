<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ForeverAH · {% block title %}{% endblock %}</title>
<style>
  :root {
    color-scheme: light;
    --page: #f9f9f7; --surface-1: #fcfcfb; --border: rgba(11,11,11,0.10);
    --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #898781;
    --grid: #e1e0d9; --axis: #c3c2b7; --series-1: #2a78d6; --context: #898781;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --page: #0d0d0d; --surface-1: #1a1a19; --border: rgba(255,255,255,0.10);
      --text-primary: #ffffff; --text-secondary: #c3c2b7; --text-muted: #898781;
      --grid: #2c2c2a; --axis: #383835; --series-1: #3987e5; --context: #898781;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page: #0d0d0d; --surface-1: #1a1a19; --border: rgba(255,255,255,0.10);
    --text-primary: #ffffff; --text-secondary: #c3c2b7; --text-muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --series-1: #3987e5; --context: #898781;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--page); color: var(--text-primary);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 1080px; margin: 0 auto; padding: 20px 16px 48px; }
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; }
  h1 { font-size: 22px; margin: 0; }
  h2 { font-size: 17px; margin: 0 0 2px; }
  nav { display: flex; gap: 4px; margin-left: auto; }
  nav a { padding: 5px 12px; border-radius: 8px; text-decoration: none; color: var(--text-secondary); }
  nav a[aria-current] { background: var(--surface-1); border: 1px solid var(--border); color: var(--text-primary); font-weight: 600; }
  .sub, .why, .note, footer { color: var(--text-secondary); }
  .sub { margin: 4px 0 20px; }
  .why { margin: 0 0 14px; max-width: 72ch; }
  .note { font-size: 13px; margin: 10px 0 0; }
  a { color: inherit; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .tile, .card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; }
  .tile { padding: 14px 16px; }
  .tile .label { color: var(--text-secondary); font-size: 13px; }
  .tile .value { font-size: 28px; font-weight: 600; line-height: 1.2; }
  .tile .note { margin: 2px 0 0; }
  .card { padding: 20px; margin-bottom: 16px; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px; }
  .two > * { min-width: 0; }
  .two h3 { font-size: 15px; margin: 0; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--grid); white-space: nowrap; vertical-align: top; }
  th { color: var(--text-secondary); font-weight: 500; font-size: 13px; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.reason { white-space: normal; min-width: 260px; color: var(--text-secondary); }
  td small { color: var(--text-secondary); margin-left: 6px; }
  tr:last-child td { border-bottom: 0; }
  .act { display: inline-block; min-width: 92px; padding: 1px 8px; border: 1px solid var(--axis); border-radius: 6px;
         font-size: 13px; font-weight: 600; text-align: center; }
  .act.quiet { font-weight: 400; color: var(--text-secondary); }
  details { margin-top: 10px; overflow-x: auto; }
  summary { cursor: pointer; color: var(--text-secondary); font-size: 13px; }
  .big { font-size: 28px; font-weight: 600; }
  footer { font-size: 13px; margin-top: 24px; }
</style>
</head>
<body>
<main class="viz-root">
  <header>
    <h1>ForeverAH · {{ title }}</h1>
    <nav>
      <a href="index.html"{% if page == "today" %} aria-current="page"{% endif %}>Today</a>
      <a href="market.html"{% if page == "market" %} aria-current="page"{% endif %}>Market</a>
    </nav>
  </header>
  {% block content %}{% endblock %}
  <footer>
    <a href="{{ attribution.url }}">{{ attribution.text }}</a> — sold-per-day, 7-day medians, item names and the comparison scan
    come from the AHledger API ({{ market }}). Everything else is from own in-game scans. Generated {{ generated }}.
  </footer>
</main>
{% block scripts %}{% endblock %}
</body>
</html>
